{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "hermes",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "hermes"
  },
  "runtimes": [
    {
      "name": "hermes",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/hermes/",
